<data name="Table of Contents">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="attributes">
        <attribute name="class">o_wblog_post_sidebar_sticky o_sticky_reactive sticky-lg-top</attribute>
    </xpath>
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block o_wblog_toc mb-2 pb-4">
            <h2 class="small mb-3">On this page</h2>
            <!-- Placeholder when there is no content to display -->
            <div class="o_wblog_toc_placeholder d-none bg-light p-3 border rounded o_not_editable">
                <h2 class="text-muted h6 mb-0"><em>No titles in the blog post</em></h2>
            </div>
            <nav class="o_wblog_toc_nav o_not_editable">
                <!-- Table of contents will be generated by JavaScript -->
            </nav>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_7"/>
    </xpath>
</data>