<data name="Share Links">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block mb-2 pb-4" t-ignore="true">
            <h2 class="small mb-3">Share this post</h2>
            <t t-snippet-call="website.s_share" string="Share" _classes.f="no_icon_color oe_unremovable oe_unmovable" _icon_classes.f="rounded-circle o_sm_custom_size shadow-sm" _style.f="--fa-icon-size: 40px;" _link_classes.f="o_wblog_share_links"/>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_3"/>
    </xpath>
</data>